scales = map([("BTC", 10**8), ("LTC", 10**8), ("ETH", 10**9)])

one_dollar = 10**8

AccountId = Int
Microcents = Int
Balance = {Microcents where  _ >= 0}
Ticker = String
CoinQuantity = {ticker: Ticker, qty: Int, scale: Int}

opening_balance = 50000000000

accts: Mut(Map(AccountId, Balance), Txn) := box(map([
    (1, opening_balance),
    (2, opening_balance),
]))

prices: Mut(Map(Ticker, Microcents), Txn) := box(map([
    ("BTC", 0),
    ("LTC", 0),
    ("ETH", 0),
]))

@LoadFrom(cart)
cart_read_only <: Map(AccountId, {ticker: Ticker, qty: Int})

cart_rescaled: Mut(Map(AccountId, CoinQuantity), Txn) := [
    (ticker=line.ticker, qty=line.qty, scale=scales[line.ticker])
    for line in cart_read_only
]

@LoadFrom(holdings)
holdings_read_only <: Map({AccountId, Ticker}, {ticker: Ticker, qty: Int})

holdings_rescaled: Mut(Map({AccountId, Ticker}, CoinQuantity), Txn) := [
    (ticker=h.ticker, qty=h.qty, scale=scales[h.ticker])
    for h in holdings_read_only
]

cart_changes,  cart_change_acks = wasm_serve("PATCH", "/cart")
checkout_reqs, checkout_acks    = wasm_serve("PUT",   "/checkout")
view_requests, view_replies     = wasm_serve("GET",   "/cart")

ticker_updates = wasm_socket_subscribe(
    "wss://ws-feed.exchange.coinbase.com",
    "ticker_batch",
    ["BTC-USD", "LTC-USD", "ETH-USD"],
)

for c in cart_changes:
    with begin():
        if c.qty >= 0:
            cart_rescaled[c.account] := (ticker=c.ticker, qty=c.qty, scale=scales[c.ticker])
        cart_change_acks << (ok=(c.qty >= 0), ticker=c.ticker, qty=c.qty)

for r in checkout_reqs:
    with begin():
        cash = accts[r.account]
        line = cart_rescaled[r.account]
        due = line.qty * prices[line.ticker] // line.scale
        if cash >= due:
            accts[r.account] := cash ^- due
            held = holdings_rescaled[(r.account, line.ticker)]
            holdings_rescaled[(r.account, line.ticker)] := (
                ticker=line.ticker, qty=held.qty + line.qty, scale=line.scale
            )
            cart_rescaled[r.account] := (ticker=line.ticker, qty=0, scale=line.scale)
        remaining = accts[r.account]
        checkout_acks << (ok=(cash >= due), due=due, cash=remaining)

for v in view_requests:
    with begin():
        line = cart_rescaled[v.account]
        px = prices[line.ticker]
        pos = holdings_rescaled[(v.account, line.ticker)]
        view_replies << (
            cash = accts[v.account],
            ticker = line.ticker,
            qty = line.qty,
            price = px,
            total = line.qty * px // line.scale,
            held = pos.qty,
        )

for u in ticker_updates:
    with begin():
        prices[u.ticker] := u.price
