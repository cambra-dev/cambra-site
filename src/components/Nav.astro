---
/**
 * Top navigation bar. Brand lockup on the left; links on the right. Links
 * without `mobile` are hidden below the sm breakpoint so the bar fits a phone;
 * the hero and footer still reach the repo and the blog.
 */
const links = [
  { label: "GitHub", href: "https://github.com/cambra-dev/cambra" },
  { label: "Blog", href: "/blog" },
  { label: "Customers", href: "/design-partners", mobile: true },
  { label: "Jobs", href: "/jobs", mobile: true },
];
---

<header
  class="w-full border-b border-[var(--color-san-blas)] bg-[var(--color-bg)]/90 backdrop-blur-sm sticky top-0 z-50"
>
  <nav
    class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between"
    aria-label="Main navigation"
  >
    <a href="/" aria-label="Cambra home" class="flex items-center">
      <img
        src="/brand/logo-horizontal.svg"
        alt="Cambra"
        class="h-9 md:h-10 w-auto"
      />
    </a>

    <div class="flex items-center gap-4 sm:gap-6 text-sm font-medium">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-[var(--color-ink-soft)] hover:text-[var(--color-accent)] transition-colors whitespace-nowrap",
              { "hidden sm:inline": !link.mobile },
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
